{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "24",
    "bun": "1.4.4"
  },
  "steps": {
    "build": {
      "commands": [
        "bun install --frozen-lockfile",
        "bun run build",
        "bun prune --production"
      ],
      "deployOutputs": [
        {
          "include": [
            "dist",
            "node_modules",
            "bun.lockb",
            "package.json",
            "package-lock.json"
          ]
        }
      ]
    }
  },
  "deploy": {
    "inputs": [
      {
        "step": "build"
      }
    ],
    "startCommand": "bun run start"
  }
}
